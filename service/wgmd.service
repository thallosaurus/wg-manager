[Unit]
Description=WireGuard Manager Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wgmd
Restart=on-failure
RestartSec=5

User=root
Group=root

#NoNewPrivileges=yes
#PrivateTmp=yes
#ProtectSystem=strict
#ProtectHome=yes
#ProtectKernelTunables=yes
#ProtectKernelModules=yes
#ProtectControlGroups=yes
#ReadWritePaths=/etc/wireguard /var/lib/wgmd /var/run

[Install]
WantedBy=multi-user.target